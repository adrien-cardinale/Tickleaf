{
  "name": "tickleaf",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@tickleaf/server' --filter '@tickleaf/web' dev",
    "build": "bun run --cwd packages/core typecheck && bun run --cwd packages/db typecheck && bun run --cwd apps/web build",
    "build:static": "bun run --cwd apps/web build:static",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:check-version": "bun apps/desktop/scripts/check-version.ts",
    "desktop:build": "bun run --cwd apps/desktop build",
    "android:dev": "bun run --cwd apps/desktop android:dev",
    "android:build": "bun run --cwd apps/desktop android:build",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/db typecheck && bun run --cwd apps/web typecheck && bun run --cwd apps/server typecheck",
    "test": "bun run --cwd packages/core test && bun run --cwd apps/web test && bun run --cwd apps/server test",
    "start": "bun apps/server/src/index.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "bun run --cwd packages/db generate",
    "db:bundle": "bun run --cwd packages/db bundle",
    "icons": "bun run --cwd apps/web icons"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "~1.3.6",
    "typescript": "^7.0.2"
  }
}
