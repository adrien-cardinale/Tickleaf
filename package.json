{
  "name": "tickleaf",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd packages/core typecheck && bun run --cwd packages/db typecheck && bun run --cwd apps/web build",
    "build:static": "bun run --cwd apps/web build:static",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/db typecheck && bun run --cwd apps/web typecheck",
    "test": "bun run --cwd packages/core test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "bun run --cwd packages/db generate",
    "db:bundle": "bun run --cwd packages/db bundle",
    "icons": "bun run --cwd apps/web icons"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "~1.3.6",
    "typescript": "^7.0.2"
  }
}
